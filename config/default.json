{
  "ui": { "language": "it" },
  "server": { "host": "127.0.0.1", "port": 4300 },

  "limits": {
    "maxParallel": 8,
    "maxSteps": 16,
    "maxRevisions": 3,
    "escalateAfter": 2,
    "maxWorkstreams": 8,
    "maxSubtasks": 5,
    "approvePlan": false,
    "askUserTimeoutMs": 300000,
    "commandTimeoutMs": 60000
  },

  "pacing": {
    "fetchMs": 2600,
    "pickupMs": 1800,
    "reviewWalkMs": 2600,
    "verdictMs": 1400,
    "deliverMs": 1400
  },

  "router": {
    "defaultCombo": "fast",
    "escalationCombo": "frontier",
    "demoFallback": true,
    "cooldownBaseMs": 15000,
    "cooldownMaxMs": 300000,
    "authCooldownMs": 600000,
    "logCalls": true
  },

  "providers": {
    "mock":       { "kind": "mock", "latencyMs": [600, 1600] },
    "anthropic":  { "kind": "anthropic", "baseUrl": "https://api.anthropic.com/v1", "keyEnv": "ANTHROPIC_API_KEY" },
    "openai":     { "kind": "openai", "baseUrl": "https://api.openai.com/v1", "keyEnv": "OPENAI_API_KEY" },
    "openrouter": { "kind": "openai", "baseUrl": "https://openrouter.ai/api/v1", "keyEnv": "OPENROUTER_API_KEY" },
    "groq":       { "kind": "openai", "baseUrl": "https://api.groq.com/openai/v1", "keyEnv": "GROQ_API_KEY" },
    "cerebras":   { "kind": "openai", "baseUrl": "https://api.cerebras.ai/v1", "keyEnv": "CEREBRAS_API_KEY" },
    "gemini":     { "kind": "openai", "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai", "keyEnv": "GEMINI_API_KEY" },
    "deepseek":   { "kind": "openai", "baseUrl": "https://api.deepseek.com/v1", "keyEnv": "DEEPSEEK_API_KEY" },
    "mistral":    { "kind": "openai", "baseUrl": "https://api.mistral.ai/v1", "keyEnv": "MISTRAL_API_KEY" },
    "ollama":     { "kind": "openai", "baseUrl": "http://127.0.0.1:11434/v1", "keyless": true, "enabled": false },
    "lmstudio":   { "kind": "openai", "baseUrl": "http://127.0.0.1:1234/v1", "keyless": true, "enabled": false }
  },

  "combos": {
    "frontier": {
      "strategy": "fallback",
      "models": ["anthropic/claude-opus-5-5", "openai/gpt-5", "gemini/gemini-2.5-pro", "anthropic/claude-sonnet-5-5"]
    },
    "smart": {
      "strategy": "fallback",
      "models": ["anthropic/claude-sonnet-5-5", "openai/gpt-5", "gemini/gemini-2.5-pro", "deepseek/deepseek-chat", "openrouter/openrouter/free"]
    },
    "fast": {
      "strategy": "fallback",
      "models": ["groq/llama-3.3-70b-versatile", "cerebras/llama-3.3-70b", "gemini/gemini-2.5-flash", "anthropic/claude-haiku-5-5", "openai/gpt-5-mini", "openrouter/openrouter/free"]
    },
    "local": {
      "strategy": "fallback",
      "models": ["ollama/qwen3:8b", "lmstudio/local-model"]
    }
  },

  "media": {
    "providers": {
      "mock":         { "kind": "mock" },
      "openai":       { "kind": "openai", "baseUrl": "https://api.openai.com/v1", "keyEnv": "OPENAI_API_KEY" },
      "fal":          { "kind": "fal", "keyEnv": "FAL_KEY" },
      "elevenlabs":   { "kind": "elevenlabs", "keyEnv": "ELEVENLABS_API_KEY", "voiceId": "21m00Tcm4TlvDq8ikWAM" },
      "pollinations": { "kind": "pollinations", "keyless": true, "enabled": false }
    },
    "image": ["openai/gpt-image-1", "fal/fal-ai/flux/schnell", "pollinations/flux"],
    "speech": ["openai/gpt-4o-mini-tts", "elevenlabs/eleven_multilingual_v2"]
  },

  "skills": {
    "sources": ["skills", "~/.claude/skills", "~/.claude/plugins", "~/.agents/skills", "~/.codex/skills"],
    "repos": ["https://github.com/vercel-labs/skills"],
    "perTask": 3,
    "skiller": {
      "enabled": true,
      "intervalHours": 24,
      "firstRunMinutes": 10,
      "queries": ["topic:agent-skills", "topic:claude-skills", "SKILL.md in:readme agent skills"],
      "webQueries": ["github agent skills SKILL.md repository"],
      "maxCandidates": 25,
      "minStars": 20,
      "maxDaysSinceCommit": 365,
      "minScore": 60,
      "trustedOwners": [],
      "autoInstall": true,
      "maxInstallsPerRun": 3,
      "maxDiskMB": 2048
    }
  },

  "rag": {
    "embeddings": ["openai/text-embedding-3-small", "mistral/mistral-embed", "gemini/gemini-embedding-001", "ollama/nomic-embed-text"],
    "dimensions": 512,
    "localDim": 256,
    "minCosine": 0.25,
    "chunk": { "maxChars": 1200, "minSimilarity": 0.5 },
    "fusion": { "k": 60, "bm25": 1.0, "vector": 1.0 }
  },

  "ceo": { "id": "ada", "name": "Ada", "title": "CEO · Regia", "color": "#f5c451", "combo": "smart" },

  "teams": {
    "research": {
      "label": "Ricerca", "title": "Researcher", "color": "#4b8ff2", "kind": "work", "combo": "fast", "prop": "globe", "maxSubAgents": 3,
      "brief": "Finds facts on the web, compares options and writes structured notes with sources that other teams build on.",
      "tools": ["web_search", "web_fetch"],
      "lead": { "id": "rino", "name": "Rino" },
      "workers": [{ "id": "sara", "name": "Sara" }]
    },
    "dev": {
      "label": "Sviluppo", "title": "Engineer", "color": "#3fbf6f", "kind": "work", "combo": "smart", "prop": "rack", "maxSubAgents": 3,
      "brief": "Writes complete, working code and files. Never leaves TODOs or placeholders, reads teammates' files before integrating them.",
      "tools": ["run_command", "web_fetch"],
      "lead": { "id": "leo", "name": "Leo" },
      "workers": [{ "id": "nina", "name": "Nina" }]
    },
    "content": {
      "label": "Contenuti", "title": "Writer", "color": "#ec6fa8", "kind": "work", "combo": "fast", "prop": "shelf", "maxSubAgents": 2,
      "brief": "Writes clear copy, scripts, docs and social content in the language of the goal.",
      "tools": ["web_search"],
      "lead": { "id": "teo", "name": "Teo" },
      "workers": [{ "id": "gaia", "name": "Gaia" }]
    },
    "design": {
      "label": "Design", "title": "Designer", "color": "#9466f0", "kind": "work", "combo": "fast", "prop": "easel", "maxSubAgents": 2,
      "brief": "Defines the visual system: palettes, typography, layout, CSS and SVG assets.",
      "tools": [],
      "lead": { "id": "iris", "name": "Iris" },
      "workers": [{ "id": "ugo", "name": "Ugo" }]
    },
    "genai": {
      "label": "AI Generativa", "title": "Generative artist", "color": "#ef4f5f", "kind": "work", "combo": "smart", "prop": "studio", "maxSubAgents": 3,
      "brief": "Creates images and voice-overs with generative models: writes precise prompts, generates, checks the result and regenerates when needed.",
      "tools": ["generate_image", "generate_speech"],
      "lead": { "id": "luna", "name": "Luna" },
      "workers": [{ "id": "dario", "name": "Dario" }]
    },
    "prompt": {
      "label": "Prompt Lab", "title": "Prompt engineer", "color": "#1fb5a8", "kind": "work", "combo": "smart", "prop": "board", "maxSubAgents": 1,
      "brief": "Turns vague requests into precise, testable instructions for agents and generative models.",
      "tools": [],
      "lead": { "id": "pia", "name": "Pia" },
      "workers": [{ "id": "max", "name": "Max" }]
    },
    "skills": {
      "label": "Skill Hub", "title": "Skill librarian", "color": "#e3b23c", "kind": "service", "combo": "fast", "prop": "library", "maxSubAgents": 0,
      "brief": "Knows every skill in the library and hands each task the few that actually help.",
      "tools": [],
      "lead": { "id": "otto", "name": "Otto" },
      "workers": []
    },
    "qa": {
      "label": "Qualità e Sicurezza", "title": "QA & security reviewer", "color": "#f28a3a", "kind": "service", "combo": "smart", "prop": "checklist", "maxSubAgents": 0,
      "brief": "Checks every deliverable against its acceptance criteria and reviews code for security problems; sends work back until it passes.",
      "tools": [],
      "lead": { "id": "bruno", "name": "Bruno" },
      "workers": [{ "id": "vera", "name": "Vera" }]
    }
  }
}
