# Agent World - copy this file to .env and fill in only the providers you use.
# With no key at all the app runs in DEMO mode: a built-in simulator plays every
# role, so you can watch the whole workflow without spending anything.

PORT=4300

# Optional: require this key on the OpenAI-compatible gateway (/v1/*).
# Leave empty to allow any local caller.
AGENT_WORLD_API_KEY=

# Providers. A combo skips every provider whose key is missing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
HF_TOKEN=

# A local OpenAI-compatible server (vLLM, llama.cpp, Jan...), e.g. http://127.0.0.1:8000/v1.
# Ollama and LM Studio have their own providers: enable them in the Settings.
LOCAL_OPENAI_URL=
LOCAL_OPENAI_KEY=

# Generative media (images and voice) for the AI Generativa team.
# OPENAI_API_KEY above also enables gpt-image-1 and text-to-speech.
FAL_KEY=
ELEVENLABS_API_KEY=

# Optional: where the Skiller may download skill repositories (Spec 05). Absolute path,
# outside this app and its data folder, not a system folder. Empty: downloads are off.
CUSTOM_DOWNLOAD_PATH=

# Optional: raises the GitHub API limit of the Skiller (60 -> 5000 requests/hour).
# A fine-grained token with read-only access to public repositories is enough.
GITHUB_TOKEN=

# Spec 07: other names the server answers to, comma separated, for a LAN setup with
# server.host 0.0.0.0 (e.g. studio.lan,192.168.1.20). 127.0.0.1, localhost and ::1
# are always allowed; any other Host is refused (DNS rebinding).
AGENT_WORLD_ALLOWED_HOSTS=

# Let agents run shell commands inside the run's project folder (tests, builds).
# Off unless set to 1: the commands are written by models.
AGENT_WORLD_ALLOW_SHELL=
